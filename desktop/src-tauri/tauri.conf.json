{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhiLogg",
  "version": "0.1.0",
  "identifier": "com.kleinphilipp.philogg",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../philogg.html": "philogg.html"
    },
    "fileAssociations": [
      {
        "ext": [
          "log"
        ],
        "name": "Log File",
        "description": "PhiLogg log file",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi"
      }
    }
  }
}
